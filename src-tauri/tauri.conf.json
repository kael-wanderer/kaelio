{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kaelio",
  "version": "0.9.5",
  "identifier": "com.kael.kaelio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Kaelio",
        "width": 1200,
        "height": 800,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline' https: http:",
        "img-src": "'self' asset: http://asset.localhost data: blob: https: http:",
        "media-src": "'self' asset: http://asset.localhost data: blob: https: http:",
        "font-src": "'self' data: https: http:",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost data: blob: https: http:",
        "worker-src": "'self' blob:",
        "frame-src": "'self' data: blob: kaelio-html: http://kaelio-html.localhost",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "devCsp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline' https: http:",
        "img-src": "'self' asset: http://asset.localhost data: blob: https: http:",
        "media-src": "'self' asset: http://asset.localhost data: blob: https: http:",
        "font-src": "'self' data: https: http:",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost data: blob: https: http: ws://localhost:1420 ws://localhost:1421",
        "worker-src": "'self' blob:",
        "frame-src": "'self' data: blob: kaelio-html: http://kaelio-html.localhost",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/kael-wanderer/kaelio/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGMTlFNDQ1OTg4RUY0MzYKUldRMjlJNllSZVFadjZlZEREM25KSm5YcDhRNnVTR3ZkUjFtcno2dVJaM0pVKzVJNVhmV2FXNmIK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "mimeType": "text/markdown",
        "description": "Markdown File"
      },
      {
        "ext": ["yaml", "yml"],
        "mimeType": "text/yaml",
        "description": "YAML File"
      },
      {
        "ext": ["txt"],
        "mimeType": "text/plain",
        "description": "Text File"
      },
      {
        "ext": ["html", "htm"],
        "mimeType": "text/html",
        "description": "HTML File"
      }
    ]
  }
}
